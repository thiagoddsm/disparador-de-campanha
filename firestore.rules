rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { 
      return request.auth != null; 
    }
    
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Admin: Token custom claim OU perfil no Firestore com role == 'admin'
    function isAdmin() { 
      return signedIn() && (
        request.auth.token.admin == true || 
        (hasUserDoc() && getUserDoc().role == 'admin')
      ); 
    }
    
    // Coordenador: Token custom claim OU perfil no Firestore com role == 'coordinator'
    function isCoordinator() { 
      return signedIn() && (
        request.auth.token.coordinator == true ||
        (hasUserDoc() && getUserDoc().role == 'coordinator') ||
        isAdmin()
      ); 
    }
    
    function isSameTeam(teamId) { 
      return (hasUserDoc() && getUserDoc().team_id == teamId) ||
             (request.auth.token.team_id == teamId) ||
             isAdmin(); 
    }

    // Regras de Usuários
    match /users/{userId} {
      allow read: if signedIn();
      
      // Apenas Admin pode criar perfis arbitrários; usuário pode criar seu próprio perfil inicial
      allow create: if signedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && request.resource.data.role == 'member')
      );
      
      // Auto-edição restrita (não pode alterar cargo ou equipe por conta própria)
      allow update: if signedIn() && (
        isAdmin() || 
        (
          request.auth.uid == userId && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'team_id', 'is_active'])
        )
      );
      
      allow delete: if isAdmin();
    }

    // Regras de Equipes
    match /teams/{teamId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Regras de Base de Contatos
    match /contacts/{contactId} {
      allow read: if signedIn() && (
        isAdmin() || 
        (isCoordinator() && isSameTeam(resource.data.team_id)) || 
        resource.data.assigned_to == request.auth.uid
      );
      
      allow create: if isAdmin() || (isCoordinator() && isSameTeam(request.resource.data.team_id));
      
      allow update: if isAdmin() || 
        (isCoordinator() && isSameTeam(resource.data.team_id)) ||
        (
          signedIn() && 
          resource.data.assigned_to == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'last_opened_at', 'confirmed_at', 'updated_at'])
        );
        
      allow delete: if isAdmin() || (isCoordinator() && isSameTeam(resource.data.team_id));
    }

    // Regras de Mensagens e Disparos
    match /messages/{messageId} {
      allow read: if signedIn() && (
        isAdmin() || 
        (isCoordinator() && isSameTeam(resource.data.team_id)) || 
        resource.data.user_uid == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.user_uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Regras de Logs de Auditoria (Append-only)
    match /audit_logs/{logId} {
      allow read: if isCoordinator() || isAdmin();
      allow create: if signedIn() && request.resource.data.actor_uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Regras de Templates de Mensagem
    match /templates/{templateId} {
      allow read: if signedIn();
      allow write: if isCoordinator() || isAdmin();
    }

    // Regras de Jobs e Integrações
    match /dispatch_jobs/{jobId} {
      allow read, write: if isCoordinator() || isAdmin();
    }

    match /integrations/{integrationId} {
      allow read, write: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
